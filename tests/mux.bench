# Example circuit 1: 2-to-1 multiplexer built only from NAND gates.
# F = A when S = 0, F = B when S = 1   ->   F = S'A + SB
# Classic static-1 hazard: A = B = 1 and S changes.
INPUT(S)
INPUT(A)
INPUT(B)
OUTPUT(F)

Sn = NAND(S, S)        # NAND with both inputs tied together = NOT
n1 = NAND(A, Sn)
n2 = NAND(B, S)
F  = NAND(n1, n2)
