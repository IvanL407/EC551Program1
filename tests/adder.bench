# Extra circuit: 1-bit full adder with two outputs (pick one with --output).
#   S    = A xor B xor Cin   (cannot be made smaller in SOP form)
#   Cout = majority(A, B, Cin)
INPUT(A)
INPUT(B)
INPUT(Cin)
OUTPUT(S)
OUTPUT(Cout)

S    = XOR(A, B, Cin)
ab   = AND(A, B)
axb  = XOR(A, B)
c2   = AND(axb, Cin)
Cout = OR(ab, c2)
